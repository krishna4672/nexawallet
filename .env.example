# ==============================================================================
# NexaWallet - Local Development Environment Variables
# Copy this file to .env and adjust variables as needed for your local setup.
# Never commit actual production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=nexawallet
POSTGRES_USER=nexa_user
POSTGRES_PASSWORD=nexa_dev_password_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# Redis Cache & Rate Limiting
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank for local dev (no auth). Set a strong value in any shared/production environment.
REDIS_PASSWORD=
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_CONNECT_TIMEOUT_MS=2000

# Phase 5: read-through cache TTL for the /api/v1/auth/me identity fields (name/email/role/createdAt
# only — wallet balance is NEVER cached, see README). Does not affect how fresh the balance is.
CACHE_USER_PROFILE_TTL_SECONDS=600

# Phase 5: distributed sliding-window rate limiting (Redis-backed, atomic Lua script).
# fail-policy=CLOSED means a Redis outage rejects auth/money requests with 503 rather than letting
# them through unlimited — see README "Redis outage behavior" before ever setting this to OPEN.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_POLICY=CLOSED
# Comma-separated IPs/CIDRs of reverse proxies this instance trusts to set X-Forwarded-For.
# Leave blank (default) to always use the raw socket address — never trust the header by default.
RATE_LIMIT_TRUSTED_PROXIES=
# HMAC key used only to derive a non-reversible per-email rate-limit bucket for login attempts;
# never logged, never stored as plaintext. Generate via 'openssl rand -hex 32' for any shared env.
RATE_LIMIT_HMAC_SECRET=change-me-rate-limit-hmac-secret-dev-only-0123456789abcdef
RATE_LIMIT_LOGIN_IP_LIMIT=10
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_ID_LIMIT=5
RATE_LIMIT_LOGIN_ID_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_IP_LIMIT=5
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_TRANSFER_USER_LIMIT=20
RATE_LIMIT_TRANSFER_USER_WINDOW_SECONDS=60
RATE_LIMIT_TRANSFER_IP_LIMIT=60
RATE_LIMIT_TRANSFER_IP_WINDOW_SECONDS=60
RATE_LIMIT_DEPOSIT_USER_LIMIT=20
RATE_LIMIT_DEPOSIT_USER_WINDOW_SECONDS=60
RATE_LIMIT_DEPOSIT_IP_LIMIT=60
RATE_LIMIT_DEPOSIT_IP_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# Apache Kafka (KRaft mode)
# ------------------------------------------------------------------------------
# Local dev tools connect to localhost:9092; Docker services connect to nexa-kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DOCKER_BOOTSTRAP_SERVERS=nexa-kafka:29092

# ------------------------------------------------------------------------------
# Elasticsearch (Phase 6: Service-Point Geo Search)
# Notice: xpack.security is disabled on the local nexa-elasticsearch container below for local
# development convenience ONLY — see docker-compose.yml. Do not disable security in production;
# set ELASTICSEARCH_USERNAME/PASSWORD once the cluster has security enabled.
# ------------------------------------------------------------------------------
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CONNECT_TIMEOUT_MS=2000
ELASTICSEARCH_SOCKET_TIMEOUT_MS=5000
# Versioned index name — bump to service_points_v2 etc. for a breaking mapping change, then
# backfill via POST /api/v1/admin/service-points/reindex (see README "Reindex & recovery").
ELASTICSEARCH_SERVICE_POINTS_INDEX=service_points_v1

# Phase 6: nearby-search bounds (see README for the full endpoint contract)
DISCOVERY_MAX_RADIUS_METERS=50000
DISCOVERY_DEFAULT_RADIUS_METERS=2000
DISCOVERY_MAX_PAGE_SIZE=100
DISCOVERY_DEFAULT_PAGE_SIZE=20
DISCOVERY_REINDEX_BATCH_SIZE=200

# ------------------------------------------------------------------------------
# Backend Application & JWT Authentication Settings
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Notice: JWT_SECRET must be at least 256 bits (32 bytes). In production, generate via 'openssl rand -hex 32'
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Application Settings (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
