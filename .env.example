# ==============================================================================
# NexaWallet - Local Development Environment Variables
# Copy this file to .env and adjust variables as needed for your local setup.
# Never commit actual production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=nexawallet
POSTGRES_USER=nexa_user
POSTGRES_PASSWORD=nexa_dev_password_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# Redis Cache & Rate Limiting
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Apache Kafka (KRaft mode)
# ------------------------------------------------------------------------------
# Local dev tools connect to localhost:9092; Docker services connect to nexa-kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DOCKER_BOOTSTRAP_SERVERS=nexa-kafka:29092

# ------------------------------------------------------------------------------
# Elasticsearch (Search & Transaction Auditing)
# Notice: For local development only. Do not disable security in production.
# ------------------------------------------------------------------------------
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# ------------------------------------------------------------------------------
# Backend Application & JWT Authentication Settings
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Notice: JWT_SECRET must be at least 256 bits (32 bytes). In production, generate via 'openssl rand -hex 32'
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Application Settings (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
